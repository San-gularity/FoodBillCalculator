# Copy to .env and drop your key in. .env is git-ignored.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Blank = auto: start with gemini-2.5-flash and fall down a chain of
# stable models if one is busy. Pin one here to always use it, e.g.
# GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL=
